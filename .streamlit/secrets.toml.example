# Copiá este archivo como  secrets.toml  (local) o pegá su contenido en
# Streamlit Cloud → Settings → Secrets.  NUNCA lo subas a GitHub.

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nAQUI_VA_LA_CLAVE_CON_\\n\n-----END PRIVATE KEY-----\n"
client_email = "buzon-rene@tu-proyecto.iam.gserviceaccount.com"
client_id = "0000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/buzon-rene%40tu-proyecto.iam.gserviceaccount.com"

[drive]
# ID de la Unidad compartida (Shared Drive) — se ve en la URL:
#   https://drive.google.com/drive/folders/0AXXXXXXXXXXXXXXXX  ->  ese es el ID
shared_drive_id = "0AXXXXXXXXXXXXXXXX"
# (Opcional) subcarpeta base dentro de la unidad. Vacío = raíz de la unidad.
base_folder_id = ""
# (Opcional) código que la gente escribe para poder subir. Vacío = sin código.
access_code = "rene2026"
