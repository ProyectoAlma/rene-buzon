# Copiá esto como  secrets.toml  (local) o pegalo en
# Streamlit Cloud -> Settings -> Secrets.  NUNCA lo subas a GitHub.

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nAQUI_VA_LA_CLAVE\n-----END PRIVATE KEY-----\n"
client_email = "buzon-rene@tu-proyecto.iam.gserviceaccount.com"
client_id = "0000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/buzon-rene%40tu-proyecto.iam.gserviceaccount.com"

[drive]
# (Opcional) código que la gente escribe para poder subir. Vacío = sin código.
access_code = "rene2026"

# NOTA: no hay que fijar una unidad acá. La app muestra en el desplegable TODAS
# las Unidades compartidas donde hayas agregado a la cuenta de servicio
# (client_email de arriba) como miembro -> agregala como "Administrador de
# contenido" en cada unidad que quieras que aparezca.
